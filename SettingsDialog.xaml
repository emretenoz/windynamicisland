<Window x:Class="WinDynamicIsland.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="360"
        Height="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
  <Window.Resources>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Box"
                      Width="22"
                      Height="22"
                      CornerRadius="7"
                      Background="#18FFFFFF"
                      BorderBrush="#26FFFFFF"
                      BorderThickness="1"
                      HorizontalAlignment="Left">
                <TextBlock x:Name="Tick"
                           Text="✓"
                           Foreground="#FFD23F"
                           FontSize="13"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
              </Border>
              <ContentPresenter Grid.Column="1"
                                VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                <Setter TargetName="Box" Property="Background" Value="#24FFFFFF" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#44FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#18FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#28FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#38FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="#F20B0B0D"
          BorderBrush="#24FFFFFF"
          BorderThickness="1"
          CornerRadius="18"
          Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <TextBlock Text="Settings"
                   Foreground="White"
                   FontSize="15"
                   FontWeight="SemiBold" />
        <TextBlock Text="Island ozelliklerini ac/kapat"
                   Foreground="#9FFFFFFF"
                   FontSize="11"
                   Margin="0,4,0,0" />
      </StackPanel>

      <ScrollViewer Grid.Row="1"
                    Margin="0,12,0,0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <CheckBox x:Name="StartWithWindowsCheckBox"
                    Content="Start with Windows" />
          <CheckBox x:Name="NotificationsCheckBox"
                    Content="Notifications" />
          <CheckBox x:Name="WeatherCheckBox"
                    Content="Idle weather card" />
          <CheckBox x:Name="ScreenshotPreviewCheckBox"
                    Content="Screenshot preview" />
          <CheckBox x:Name="TimerCheckBox"
                    Content="Timer controls" />
          <CheckBox x:Name="SystemAlertsCheckBox"
                    Content="System alerts" />
          <TextBlock Text="Display"
                     Foreground="#9FFFFFFF"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Margin="0,14,0,6" />
          <ComboBox x:Name="DisplayComboBox"
                    Height="34"
                    Foreground="White"
                    Background="#18FFFFFF"
                    BorderThickness="0" />
        </StackPanel>
      </ScrollViewer>

      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Margin="0,16,0,0">
        <Button Width="78"
                Height="32"
                Margin="0,0,8,0"
                Content="Iptal"
                Click="CancelButton_Click" />
        <Button Width="78"
                Height="32"
                Content="Kaydet"
                Click="SaveButton_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
