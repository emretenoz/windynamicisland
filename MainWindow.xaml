<Window x:Class="WinDynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDynamicIsland"
        Width="360"
        Height="120"
        Topmost="True"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
  <Window.Resources>
    <QuadraticEase x:Key="IslandEase" EasingMode="EaseInOut" />
    <Style x:Key="MediaIconButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#18FFFFFF" />
      <Setter Property="BorderBrush" Value="#20FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="15">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#2CFFFFFF" />
                <Setter TargetName="Root" Property="BorderBrush" Value="#38FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#40FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation Storyboard.TargetName="GlowBorder"
                       Storyboard.TargetProperty="Opacity"
                       From="0.45"
                       To="1"
                       Duration="0:0:0.65" />
      <DoubleAnimation Storyboard.TargetName="GlowScale"
                       Storyboard.TargetProperty="ScaleX"
                       From="1"
                       To="1.035"
                       Duration="0:0:0.65" />
      <DoubleAnimation Storyboard.TargetName="GlowScale"
                       Storyboard.TargetProperty="ScaleY"
                       From="1"
                       To="1.12"
                       Duration="0:0:0.65" />
    </Storyboard>
  </Window.Resources>

  <Grid Background="Transparent">
    <Border x:Name="Island"
            Width="190"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,8,0,0"
            CornerRadius="18"
            Background="#F0000000"
            Cursor="Hand"
            ClipToBounds="True"
            MouseLeftButtonUp="Island_MouseLeftButtonUp">
      <Grid>
        <Border x:Name="GlowBorder"
                CornerRadius="22"
                BorderThickness="1.5"
                BorderBrush="#56F45B69"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform>
            <ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1" />
          </Border.RenderTransform>
        </Border>

        <Grid Margin="12,6">
          <Grid x:Name="MediaCompactView">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Fill="#1DB954" Margin="0,0,10,0" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="3" Height="10" CornerRadius="1.5" Background="#DFFFFFFF" Margin="0,0,3,0" />
                <Border Width="3" Height="16" CornerRadius="1.5" Background="#FFFFFFFF" Margin="0,0,3,0" />
                <Border Width="3" Height="8" CornerRadius="1.5" Background="#AFFFFFFF" Margin="0,0,3,0" />
                <Border Width="3" Height="13" CornerRadius="1.5" Background="#CFFFFFFF" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <Grid x:Name="MediaExpandedView" Opacity="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="54" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="108" />
            </Grid.ColumnDefinitions>
            <Border Width="46" Height="46" CornerRadius="6" Background="#1D1D1F" ClipToBounds="True">
              <Image x:Name="AlbumArtImage" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
              <TextBlock x:Name="ExpandedTitleText"
                         Text="Media"
                         Foreground="White"
                         FontSize="13"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ExpandedArtistText"
                         Text="Listening"
                         Foreground="#B8FFFFFF"
                         FontSize="11"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
              <Button x:Name="PrevButton" Click="PrevButton_Click" Style="{StaticResource MediaIconButtonStyle}">
                <Path Fill="White" Stretch="Uniform" Width="12" Height="12" Data="M 10 2 L 4 6 L 10 10 Z M 3 2 L 1.8 2 L 1.8 10 L 3 10 Z" />
              </Button>
              <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click" Style="{StaticResource MediaIconButtonStyle}">
                <Grid Width="13" Height="13">
                  <Path Fill="White" Stretch="Uniform" Data="M 2 1 L 2 12 L 5 12 L 5 1 Z M 8 1 L 8 12 L 11 12 L 11 1 Z" />
                </Grid>
              </Button>
              <Button x:Name="NextButton" Click="NextButton_Click" Style="{StaticResource MediaIconButtonStyle}">
                <Path Fill="White" Stretch="Uniform" Width="12" Height="12" Data="M 2 2 L 8 6 L 2 10 Z M 9 2 L 10.2 2 L 10.2 10 L 9 10 Z" />
              </Button>
            </StackPanel>
          </Grid>

          <Grid x:Name="RecordingView" Opacity="0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Ellipse Width="10" Height="10" Fill="#F45B69" Margin="0,0,8,0" />
              <TextBlock Text="Recording..."
                         Foreground="White"
                         FontSize="13"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Grid>

          <Grid x:Name="ThinkingView" Opacity="0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <ProgressBar Width="54"
                           Height="6"
                           Margin="0,0,10,0"
                           IsIndeterminate="True"
                           Foreground="#1DB954" />
              <TextBlock Text="Thinking..."
                         Foreground="White"
                         FontSize="13"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Grid>

          <Grid x:Name="ResponseView" Opacity="0" Visibility="Collapsed">
            <TextBlock x:Name="ResponseText"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
          </Grid>

          <Grid x:Name="NotificationView" Opacity="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="30"
                    Height="30"
                    CornerRadius="15"
                    Background="#24FFFFFF"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="1"
                    VerticalAlignment="Center">
              <Path Fill="White"
                    Width="14"
                    Height="14"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="M 6 1.2 C 3.8 1.2 2.4 2.8 2.4 5 L 2.4 7.3 L 1.4 8.9 L 1.4 10 L 10.6 10 L 10.6 8.9 L 9.6 7.3 L 9.6 5 C 9.6 2.8 8.2 1.2 6 1.2 Z M 4.4 10.8 C 4.7 11.8 5.3 12.3 6 12.3 C 6.7 12.3 7.3 11.8 7.6 10.8 Z" />
            </Border>
            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="NotificationAppText"
                         Text="Notification"
                         Foreground="White"
                         FontSize="12"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="NotificationMessageText"
                         Text=""
                         Foreground="#B8FFFFFF"
                         FontSize="10.5"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
