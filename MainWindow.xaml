<Window x:Class="WinDynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDynamicIsland"
        Width="620"
        Height="460"
        Topmost="True"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseWheel="Window_MouseWheel">
  <Window.Resources>
    <QuadraticEase x:Key="IslandEase" EasingMode="EaseInOut" />
    <Style TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="HasDropShadow" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="#F20B0B0D"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="6">
              <StackPanel IsItemsHost="True" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="210" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Root"
                    Background="Transparent"
                    CornerRadius="8"
                    Padding="10,0"
                    SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="18" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CheckMark"
                           Text="✓"
                           Foreground="#FFD23F"
                           FontSize="12"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
                <ContentPresenter Grid.Column="1"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#34FFFFFF" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#66FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Separator">
      <Setter Property="Margin" Value="8,5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1"
                    Background="#18FFFFFF" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MediaIconButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="20">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#24FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#34FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Storyboard x:Key="MediaPlayingStoryboard" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation Storyboard.TargetName="CompactBarOne"
                       Storyboard.TargetProperty="Height"
                       From="6"
                       To="16"
                       Duration="0:0:0.42" />
      <DoubleAnimation Storyboard.TargetName="CompactBarTwo"
                       Storyboard.TargetProperty="Height"
                       From="10"
                       To="19"
                       BeginTime="0:0:0.08"
                       Duration="0:0:0.46" />
      <DoubleAnimation Storyboard.TargetName="CompactBarThree"
                       Storyboard.TargetProperty="Height"
                       From="18"
                       To="7"
                       BeginTime="0:0:0.16"
                       Duration="0:0:0.5" />
      <DoubleAnimation Storyboard.TargetName="CompactBarFour"
                       Storyboard.TargetProperty="Height"
                       From="8"
                       To="17"
                       BeginTime="0:0:0.24"
                       Duration="0:0:0.44" />
      <DoubleAnimation Storyboard.TargetName="CompactBarFive"
                       Storyboard.TargetProperty="Height"
                       From="14"
                       To="5"
                       BeginTime="0:0:0.32"
                       Duration="0:0:0.48" />
    </Storyboard>
  </Window.Resources>

  <Grid Background="Transparent">
    <Border x:Name="Island"
            Width="58"
            Height="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,8,0,0"
            CornerRadius="18"
            Background="#EE000000"
            Cursor="Hand"
            ClipToBounds="True"
            Opacity="1"
            RenderTransformOrigin="0.5,0.5"
            MouseLeftButtonUp="Island_MouseLeftButtonUp">
      <Border.RenderTransform>
        <ScaleTransform x:Name="IslandScale" ScaleX="1" ScaleY="1" />
      </Border.RenderTransform>
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem x:Name="StartupMenuItem"
                    Header="Start with Windows"
                    IsCheckable="True"
                    Click="StartupMenuItem_Click" />
          <MenuItem Header="Notification Settings"
                    Click="NotificationSettingsMenuItem_Click" />
          <MenuItem Header="Settings"
                    Click="SettingsMenuItem_Click" />
          <Separator />
          <MenuItem Header="Switch Audio Output"
                    Click="SwitchAudioOutputMenuItem_Click" />
          <MenuItem Header="Timer 5 min"
                    Click="TimerFiveMenuItem_Click" />
          <MenuItem Header="Timer 10 min"
                    Click="TimerTenMenuItem_Click" />
          <MenuItem Header="Timer 15 min"
                    Click="TimerFifteenMenuItem_Click" />
          <MenuItem Header="Timer 30 min"
                    Click="TimerThirtyMenuItem_Click" />
          <MenuItem Header="Timer 45 min"
                    Click="TimerFortyFiveMenuItem_Click" />
          <MenuItem Header="Timer 60 min"
                    Click="TimerSixtyMenuItem_Click" />
          <MenuItem Header="Custom Timer..."
                    Click="TimerCustomMenuItem_Click" />
          <MenuItem Header="Stop Timer"
                    Click="TimerStopMenuItem_Click" />
          <Separator />
          <MenuItem Header="Exit"
                    Click="ExitMenuItem_Click" />
        </ContextMenu>
      </Border.ContextMenu>
      <Grid>
        <Border x:Name="IslandStroke"
                CornerRadius="{Binding CornerRadius, ElementName=Island}"
                BorderBrush="#12FFFFFF"
                BorderThickness="1"
                IsHitTestVisible="False" />
        <Grid>
          <Grid x:Name="MediaCompactView" Margin="10,0">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel x:Name="CompactMediaIndicator"
                          Grid.Column="0"
                          Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border x:Name="CompactBarOne" Width="2.5" Height="6" CornerRadius="1.25" Background="#BFFFFFFF" Margin="0,0,3,0" VerticalAlignment="Center" />
                  <Border x:Name="CompactBarTwo" Width="2.5" Height="10" CornerRadius="1.25" Background="#FFFFFFFF" Margin="0,0,3,0" VerticalAlignment="Center" />
                  <Border x:Name="CompactBarThree" Width="2.5" Height="18" CornerRadius="1.25" Background="#FF1DB954" Margin="0,0,3,0" VerticalAlignment="Center" />
                  <Border x:Name="CompactBarFour" Width="2.5" Height="8" CornerRadius="1.25" Background="#FFFFFFFF" Margin="0,0,3,0" VerticalAlignment="Center" />
                  <Border x:Name="CompactBarFive" Width="2.5" Height="14" CornerRadius="1.25" Background="#BFFFFFFF" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
              <TextBlock x:Name="CompactTimerText"
                         Grid.Column="1"
                         Text="05:00"
                         Foreground="White"
                         FontSize="12.5"
                         FontWeight="SemiBold"
                         Margin="0"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="Collapsed" />
              <Border x:Name="CompactSplitDivider"
                      Grid.Column="2"
                      Width="1"
                      Height="14"
                      Background="#24FFFFFF"
                      Margin="9,0,0,0"
                      VerticalAlignment="Center"
                      Visibility="Collapsed" />
              <StackPanel x:Name="PrivacyIndicator"
                          Grid.Column="3"
                          Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0"
                          Visibility="Collapsed">
                <Ellipse x:Name="CameraDot"
                         Width="6"
                         Height="6"
                         Fill="#27D65A"
                         Margin="0,0,4,0"
                         Visibility="Collapsed" />
                <Ellipse x:Name="MicrophoneDot"
                         Width="6"
                         Height="6"
                         Fill="#FFD23F"
                         Visibility="Collapsed" />
              </StackPanel>
            </Grid>
          </Grid>

          <Grid x:Name="MediaExpandedView" Margin="16,9" Opacity="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="76" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="86" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="146" />
            </Grid.ColumnDefinitions>
            <Border Width="76" Height="76" CornerRadius="16" Background="#1D1D1F" ClipToBounds="True">
              <Image x:Name="AlbumArtImage" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,14,0" VerticalAlignment="Center">
              <TextBlock x:Name="ExpandedTitleText"
                         Text="Media"
                         Foreground="White"
                         FontSize="15"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ExpandedArtistText"
                         Text="Listening"
                         Foreground="#B8FFFFFF"
                         FontSize="12.5"
                         TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Border Width="18"
                        Height="18"
                        CornerRadius="6"
                        Background="#20FFFFFF"
                        VerticalAlignment="Center">
                  <Path Fill="#D8FFFFFF"
                        Width="10"
                        Height="10"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 6 1.2 C 3.4 1.2 1.2 3.4 1.2 6 C 1.2 8.6 3.4 10.8 6 10.8 C 8.6 10.8 10.8 8.6 10.8 6 C 10.8 3.4 8.6 1.2 6 1.2 Z M 5 3.6 L 8 6 L 5 8.4 Z" />
                </Border>
                <TextBlock x:Name="SourceAppText"
                           Text="Media"
                           Foreground="#88FFFFFF"
                           FontSize="11"
                           Margin="7,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
              <Button x:Name="PrevButton" Click="PrevButton_Click" Style="{StaticResource MediaIconButtonStyle}">
                <Path Fill="White" Stretch="Uniform" Width="15" Height="15" Data="M 10 2 L 4 6 L 10 10 Z M 3 2 L 1.8 2 L 1.8 10 L 3 10 Z" />
              </Button>
              <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click" Style="{StaticResource MediaIconButtonStyle}">
                <Grid Width="16" Height="16">
                  <Path x:Name="PlayPauseIconPath"
                        Fill="White"
                        Stretch="Uniform"
                        Data="M 2 1 L 2 12 L 5 12 L 5 1 Z M 8 1 L 8 12 L 11 12 L 11 1 Z" />
                </Grid>
              </Button>
              <Button x:Name="NextButton" Click="NextButton_Click" Style="{StaticResource MediaIconButtonStyle}">
                <Path Fill="White" Stretch="Uniform" Width="15" Height="15" Data="M 2 2 L 8 6 L 2 10 Z M 9 2 L 10.2 2 L 10.2 10 L 9 10 Z" />
              </Button>
            </StackPanel>
            <Grid x:Name="TimerPanel"
                  Grid.Row="1"
                  Grid.ColumnSpan="3"
                  Height="24"
                  Margin="0,8,0,0"
                  Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Timer"
                         Foreground="#B8FFFFFF"
                         FontSize="10.5"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0" />
              <Border Grid.Column="1"
                      Height="4"
                      CornerRadius="2"
                      Background="#24FFFFFF"
                      VerticalAlignment="Center">
                <Border x:Name="TimerProgressFill"
                        Width="0"
                        HorizontalAlignment="Left"
                        CornerRadius="2"
                        Background="#FFD23F" />
              </Border>
              <TextBlock x:Name="TimerTimeText"
                         Grid.Column="2"
                         Text="25:00"
                         Foreground="White"
                         FontSize="11"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Margin="10,0,0,0" />
            </Grid>
          </Grid>

          <Grid x:Name="NotificationView" Margin="14,8" Opacity="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="38"
                    Height="38"
                    CornerRadius="19"
                    Background="#24FFFFFF"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="1"
                    VerticalAlignment="Center">
              <Grid>
                <Image x:Name="NotificationLogoImage"
                       Width="30"
                       Height="30"
                       Stretch="UniformToFill"
                       Visibility="Collapsed" />
                <Path x:Name="NotificationFallbackIcon"
                      Fill="White"
                      Width="18"
                      Height="18"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 6 1.2 C 3.8 1.2 2.4 2.8 2.4 5 L 2.4 7.3 L 1.4 8.9 L 1.4 10 L 10.6 10 L 10.6 8.9 L 9.6 7.3 L 9.6 5 C 9.6 2.8 8.2 1.2 6 1.2 Z M 4.4 10.8 C 4.7 11.8 5.3 12.3 6 12.3 C 6.7 12.3 7.3 11.8 7.6 10.8 Z" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="NotificationAppText"
                         Text="Notification"
                         Foreground="White"
                         FontSize="12"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="NotificationMessageText"
                         Text=""
                         Foreground="#B8FFFFFF"
                         FontSize="10.5"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>

          <Grid x:Name="UtilityView" Margin="14,8" Opacity="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="34"
                    Height="34"
                    CornerRadius="17"
                    Background="#22FFFFFF"
                    VerticalAlignment="Center">
              <TextBlock x:Name="UtilityIconText"
                         Text="•"
                         Foreground="White"
                         FontSize="16"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="UtilityTitleText"
                         Text="WinDynamicIsland"
                         Foreground="White"
                         FontSize="12"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="UtilityDetailText"
                         Text=""
                         Foreground="#B8FFFFFF"
                         FontSize="10.5"
                         TextTrimming="CharacterEllipsis" />
              <Border Height="3"
                      CornerRadius="1.5"
                      Background="#24FFFFFF"
                      Margin="0,5,0,0">
                <Border x:Name="UtilityProgressFill"
                        Width="0"
                        HorizontalAlignment="Left"
                        CornerRadius="1.5"
                        Background="#FFFFFFFF" />
              </Border>
            </StackPanel>
          </Grid>

          <Grid x:Name="ScreenshotPreviewView" Margin="12,10" Opacity="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="24" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
              <TextBlock Text="Screenshot"
                         Foreground="White"
                         FontSize="12"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <TextBlock Text="panoya kopyalandi"
                         Foreground="#8FFFFFFF"
                         FontSize="9.5"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="1"
                    Margin="0,6,0,0"
                    CornerRadius="16"
                    Background="#141414"
                    ClipToBounds="True">
              <Image x:Name="ScreenshotPreviewImage"
                     Stretch="Uniform" />
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Border>

  </Grid>
</Window>
