<Window x:Class="WinDynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDynamicIsland"
        Width="620"
        Height="460"
        Topmost="True"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        MouseWheel="Window_MouseWheel">
  <Window.Resources>
    <CubicEase x:Key="IslandEase" EasingMode="EaseOut" />
    <Style TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="HasDropShadow" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="#F20B0B0D"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="6">
              <StackPanel IsItemsHost="True" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinWidth" Value="210" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="Root"
                    Background="Transparent"
                    CornerRadius="8"
                    Padding="10,0"
                    SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="18" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CheckMark"
                           Text="✓"
                           Foreground="#FFD23F"
                           FontSize="12"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
                <ContentPresenter Grid.Column="1"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#34FFFFFF" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#66FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Separator">
      <Setter Property="Margin" Value="8,5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1"
                    Background="#18FFFFFF" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MediaIconButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#14FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="20">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#24FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#34FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TopBarButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Foreground" Value="#EFFFFFFF" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="TopBarButtonRoot"
                    Background="{TemplateBinding Background}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TopBarButtonRoot" Property="Background" Value="#24FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="TopBarButtonRoot" Property="Background" Value="#3A9D35C7" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DockAppButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Margin" Value="0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Panel.ZIndex" Value="4" />
                <Setter Property="Background" Value="#18FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CalendarDayButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="DayRoot"
                    Width="34"
                    Height="34"
                    Background="{TemplateBinding Background}"
                    CornerRadius="17">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="DayRoot" Property="Background" Value="#28FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="DayRoot" Property="Opacity" Value="0.72" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="VolumeSliderStyle" TargetType="Slider">
      <Setter Property="Height" Value="24" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center">
              <Track x:Name="PART_Track" Height="20">
                <Track.DecreaseRepeatButton>
                  <RepeatButton BorderThickness="0" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" Background="#42BDF5" CornerRadius="2" VerticalAlignment="Center" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="15" Height="15">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid>
                          <Ellipse Width="22" Height="22" Fill="#2942BDF5" />
                          <Ellipse Width="12" Height="12" Fill="#42BDF5" />
                        </Grid>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton BorderThickness="0" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" Background="#70FFFFFF" CornerRadius="2" VerticalAlignment="Center" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="OutputDeviceButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="DeviceRoot" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="DeviceRoot" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="DeviceRoot" Property="Background" Value="#35FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Storyboard x:Key="MediaPlayingStoryboard" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation Storyboard.TargetName="CompactBarOne"
                       Storyboard.TargetProperty="Height"
                       From="6"
                       To="16"
                       Duration="0:0:0.42" />
      <DoubleAnimation Storyboard.TargetName="CompactBarTwo"
                       Storyboard.TargetProperty="Height"
                       From="10"
                       To="19"
                       BeginTime="0:0:0.08"
                       Duration="0:0:0.46" />
      <DoubleAnimation Storyboard.TargetName="CompactBarThree"
                       Storyboard.TargetProperty="Height"
                       From="18"
                       To="7"
                       BeginTime="0:0:0.16"
                       Duration="0:0:0.5" />
      <DoubleAnimation Storyboard.TargetName="CompactBarFour"
                       Storyboard.TargetProperty="Height"
                       From="8"
                       To="17"
                       BeginTime="0:0:0.24"
                       Duration="0:0:0.44" />
      <DoubleAnimation Storyboard.TargetName="CompactBarFive"
                       Storyboard.TargetProperty="Height"
                       From="14"
                       To="5"
                       BeginTime="0:0:0.32"
                       Duration="0:0:0.48" />
    </Storyboard>
  </Window.Resources>

  <Grid Background="Transparent">
    <Border x:Name="TopBar"
            Height="38"
            VerticalAlignment="Top"
            Background="#F20A0A0D"
            BorderBrush="#8A9D35C7"
            BorderThickness="0,0,0,1">
      <Grid Margin="8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="IslandBarSpacer"
                Grid.Column="1"
                Width="92"
                Height="38"
                Background="Transparent" />

        <Grid Grid.Column="0">
          <Button Style="{StaticResource TopBarButtonStyle}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  Padding="5,0"
                  ToolTip="EMR UI ayarlarını aç"
                  Click="TopBarHomeButton_Click">
            <Grid VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="TopBarBrandBadge"
                      Grid.Column="0"
                      Width="18"
                      Height="18"
                      CornerRadius="5"
                      Background="#18FFFFFF"
                      BorderBrush="#20FFFFFF"
                      BorderThickness="1">
                <TextBlock x:Name="TopBarBrandMark"
                           Text="◆"
                           Foreground="#D65AE8"
                           FontSize="9"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Column="1"
                         Text="EMR UI"
                         FontWeight="SemiBold"
                         Margin="7,0,0,0"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="2"
                         Text="/"
                         Foreground="#50FFFFFF"
                         FontSize="12"
                         Margin="9,0,8,0"
                         VerticalAlignment="Center" />
              <TextBlock x:Name="TopBarActivityText"
                         Grid.Column="3"
                         Text="Dynamic Island"
                         Foreground="#BFFFFFFF"
                         FontSize="11"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
            </Grid>
          </Button>
        </Grid>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <Button Style="{StaticResource TopBarButtonStyle}"
                  Padding="8,0"
                  ToolTip="Pano geçmişi"
                  Click="TopBarClipboardButton_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="Pano" FontSize="10.5" Margin="5,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource TopBarButtonStyle}"
                  Padding="8,0"
                  ToolTip="5 dakikalık sayaç başlat"
                  Click="TopBarTimerButton_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="5 dk" FontSize="10.5" Margin="5,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="TopBarNetworkButton" Style="{StaticResource TopBarButtonStyle}" ToolTip="Ağ ayarlarını aç" Click="TopBarNetworkButton_Click">
            <TextBlock x:Name="TopBarNetworkText" Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
          </Button>
          <Button x:Name="TopBarVolumeButton" Style="{StaticResource TopBarButtonStyle}" Padding="9,0" ToolTip="Ses düzeyini aç" Click="TopBarVolumeButton_Click">
            <Border Background="#12FFFFFF" CornerRadius="10" Padding="7,3">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TopBarVolumeIcon"
                           Text="&#xE767;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           Foreground="#EFFFFFFF"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TopBarVolumeText"
                           Text="--%"
                           Foreground="#BFFFFFFF"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </Button>
          <Button x:Name="TopBarClockButton" Style="{StaticResource TopBarButtonStyle}" ToolTip="Takvim ve saati aç" Click="TopBarClockButton_Click">
            <TextBlock x:Name="TopBarClockText" Text="00:00" FontWeight="SemiBold" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="DockBar"
            MinWidth="54"
            MaxWidth="820"
            Height="58"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,2"
            Background="#CC151518"
            BorderBrush="#30FFFFFF"
            BorderThickness="1"
            CornerRadius="18"
            Padding="6,5">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.38" Color="Black" />
      </Border.Effect>
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="DockLauncherButton"
                Style="{StaticResource DockAppButtonStyle}"
                Width="40"
                ToolTip="Uygulamaları aç"
                Click="DockLauncherButton_Click">
          <Grid Width="34" Height="40">
            <Border Width="32"
                    Height="32"
                    CornerRadius="10"
                    Background="#24FFFFFF"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
              <TextBlock x:Name="DockLauncherMark"
                         Text="&#xE80F;"
                         FontFamily="Segoe MDL2 Assets"
                         Foreground="#D65AE8"
                         FontSize="17"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Button>
        <Border Width="1"
                Height="30"
                Background="#22FFFFFF"
                Margin="5,0,6,0" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
          <StackPanel x:Name="DockAppsPanel"
                      Orientation="Horizontal"
                      VerticalAlignment="Center" />
        </ScrollViewer>
        </StackPanel>
        <Border x:Name="DockDragHandle"
                Width="28"
                Height="4"
                Margin="0,-3,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#78FFFFFF"
                CornerRadius="2"
                Cursor="SizeAll"
                Visibility="Collapsed"
                ToolTip="Dock'u sürükleyerek taşı"
                PreviewMouseLeftButtonDown="DockDragHandle_PreviewMouseLeftButtonDown"
                PreviewMouseMove="DockDragHandle_PreviewMouseMove"
                PreviewMouseLeftButtonUp="DockDragHandle_PreviewMouseLeftButtonUp" />
      </Grid>
    </Border>

    <Border x:Name="StartMenuPanel"
            Width="560"
            Height="430"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,72"
            Background="#F217171A"
            BorderBrush="#32FFFFFF"
            BorderThickness="1"
            CornerRadius="18"
            Padding="16"
            Visibility="Collapsed">
      <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.55" Color="Black" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="42" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#141414"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="13"
                Padding="12,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;"
                       FontFamily="Segoe MDL2 Assets"
                       Foreground="#42BDF5"
                       FontSize="15"
                       VerticalAlignment="Center" />
            <TextBox x:Name="StartSearchBox"
                     Grid.Column="1"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     CaretBrush="White"
                     FontSize="13"
                     ToolTip="Uygulama ara"
                     VerticalContentAlignment="Center"
                     TextChanged="StartSearchBox_TextChanged"
                     KeyDown="StartSearchBox_KeyDown" />
          </Grid>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="Sabitlenenler"
                   Foreground="#DFFFFFFF"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Margin="4,18,0,10" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <UniformGrid x:Name="LauncherPinnedPanel"
                         Columns="6"
                         Margin="0,0,0,18" />
            <TextBlock Text="Açık uygulamalar"
                       Foreground="#9FFFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="4,0,0,10" />
            <UniformGrid x:Name="LauncherRunningPanel"
                         Columns="6"
                         Margin="0,0,0,18" />
            <TextBlock Text="Tüm uygulamalar"
                       Foreground="#9FFFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="4,0,0,10" />
            <UniformGrid x:Name="LauncherInstalledPanel"
                         Columns="6" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Popup x:Name="CalendarPopup"
           PlacementTarget="{Binding ElementName=TopBarClockButton}"
           Placement="Bottom"
           HorizontalOffset="-264"
           VerticalOffset="6"
           AllowsTransparency="True"
           StaysOpen="False"
           PopupAnimation="Fade"
           Opened="CalendarPopup_Opened">
      <Border Width="330"
              Background="#FA202023"
              BorderBrush="#32FFFFFF"
              BorderThickness="1"
              CornerRadius="14"
              Padding="16">
        <Border.Effect>
          <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="CalendarTodayText" Text="27 Ağustos Perşembe" Foreground="White" FontSize="13" />
              <TextBlock Text="Bugün" Foreground="#7FFFFFFF" FontSize="10" Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock x:Name="CalendarClockText"
                       Grid.Column="1"
                       Text="15:08"
                       Foreground="White"
                       FontSize="25"
                       FontWeight="Light"
                       VerticalAlignment="Center" />
          </Grid>

          <Border Grid.Row="1" Background="#20FFFFFF" />

          <Grid Grid.Row="2" Margin="0,13,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="34" />
              <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CalendarMonthText" Text="Ağustos 2026" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource TopBarButtonStyle}" Padding="0" Content="‹" FontSize="20" ToolTip="Önceki ay" Click="CalendarPreviousMonth_Click" />
            <Button Grid.Column="2" Style="{StaticResource TopBarButtonStyle}" Padding="0" Content="›" FontSize="20" ToolTip="Sonraki ay" Click="CalendarNextMonth_Click" />
          </Grid>

          <UniformGrid Grid.Row="3" Columns="7" Rows="1" Margin="0,0,0,4">
            <TextBlock Text="Pt" Foreground="#BFFFFFFF" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Text="Sa" Foreground="#BFFFFFFF" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Text="Ça" Foreground="#BFFFFFFF" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Text="Pe" Foreground="#BFFFFFFF" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Text="Cu" Foreground="#BFFFFFFF" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Text="Ct" Foreground="#BFFFFFFF" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Text="Pa" Foreground="#BFFFFFFF" FontSize="11" HorizontalAlignment="Center" />
          </UniformGrid>

          <UniformGrid x:Name="CalendarDaysGrid" Grid.Row="4" Columns="7" Rows="6" />
        </Grid>
      </Border>
    </Popup>

    <Popup x:Name="VolumePopup"
           PlacementTarget="{Binding ElementName=TopBarVolumeButton}"
           Placement="Bottom"
           HorizontalOffset="-216"
           VerticalOffset="6"
           AllowsTransparency="True"
           StaysOpen="False"
           PopupAnimation="Fade"
           Opened="VolumePopup_Opened">
      <Border Width="310"
              Height="58"
              Background="#FA252527"
              BorderBrush="#32FFFFFF"
              BorderThickness="1"
              CornerRadius="12"
              Padding="12,8">
        <Border.Effect>
          <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="46" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="VolumePopupIcon"
                     Text="&#xE995;"
                     FontFamily="Segoe MDL2 Assets"
                     FontSize="16"
                     Foreground="White"
                     VerticalAlignment="Center" />
          <Slider x:Name="VolumeSlider"
                  Grid.Column="1"
                  Style="{StaticResource VolumeSliderStyle}"
                  Minimum="0"
                  Maximum="100"
                  ValueChanged="VolumeSlider_ValueChanged" />
          <Button x:Name="VolumeOutputButton"
                  Grid.Column="2"
                  Style="{StaticResource TopBarButtonStyle}"
                  Padding="4,0"
                  ToolTip="Ses çıkışını değiştir"
                  Click="VolumeOutputButton_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7F5;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
              <TextBlock Text="›" FontSize="18" Margin="4,-1,0,0" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Popup>

    <Popup x:Name="OutputDevicePopup"
           PlacementTarget="{Binding ElementName=TopBarVolumeButton}"
           Placement="Bottom"
           HorizontalOffset="-246"
           VerticalOffset="6"
           AllowsTransparency="True"
           StaysOpen="False"
           PopupAnimation="Fade">
      <Border Width="345"
              Background="#FA252527"
              BorderBrush="#32FFFFFF"
              BorderThickness="1"
              CornerRadius="12"
              Padding="8">
        <Border.Effect>
          <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Çıkış cihazı" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="8,5,8,11" />
          <Border Grid.Row="1" Background="#20FFFFFF" />
          <ScrollViewer Grid.Row="2" MaxHeight="260" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="OutputDevicesPanel" Margin="0,6,0,0" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Popup>

    <Grid x:Name="IslandHoverZone"
          Width="92"
          Height="38"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Background="Transparent"
          MouseEnter="Window_MouseEnter"
          MouseLeave="Window_MouseLeave">
      <Border x:Name="IslandPocket"
              Width="76"
              Height="32"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,3,0,0"
              CornerRadius="18"
              Background="Transparent"
              BorderBrush="Transparent"
              BorderThickness="1"
              IsHitTestVisible="False" />
      <Border x:Name="Island"
              Width="58"
              Height="24"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,7,0,0"
              CornerRadius="18"
              Background="#EE000000"
              Cursor="Hand"
              ToolTip="Tıklayın veya sürükleyerek taşıyın"
              ClipToBounds="True"
              Opacity="1"
              RenderTransformOrigin="0.5,0.5"
              PreviewMouseLeftButtonDown="Island_PreviewMouseLeftButtonDown"
              PreviewMouseMove="Island_PreviewMouseMove"
              PreviewMouseLeftButtonUp="Island_PreviewMouseLeftButtonUp"
              MouseLeftButtonUp="Island_MouseLeftButtonUp">
      <Border.RenderTransform>
        <ScaleTransform x:Name="IslandScale" ScaleX="1" ScaleY="1" />
      </Border.RenderTransform>
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem x:Name="StartupMenuItem"
                    Header="Windows ile birlikte başlat"
                    IsCheckable="True"
                    Click="StartupMenuItem_Click" />
          <MenuItem Header="Bildirim ayarları"
                    Click="NotificationSettingsMenuItem_Click" />
          <MenuItem Header="Ayarlar"
                    Click="SettingsMenuItem_Click" />
          <Separator />
          <MenuItem Header="Ses çıkışını değiştir"
                    Click="SwitchAudioOutputMenuItem_Click" />
          <MenuItem Header="5 dakikalık sayaç"
                    Click="TimerFiveMenuItem_Click" />
          <MenuItem Header="10 dakikalık sayaç"
                    Click="TimerTenMenuItem_Click" />
          <MenuItem Header="15 dakikalık sayaç"
                    Click="TimerFifteenMenuItem_Click" />
          <MenuItem Header="30 dakikalık sayaç"
                    Click="TimerThirtyMenuItem_Click" />
          <MenuItem Header="45 dakikalık sayaç"
                    Click="TimerFortyFiveMenuItem_Click" />
          <MenuItem Header="60 dakikalık sayaç"
                    Click="TimerSixtyMenuItem_Click" />
          <MenuItem Header="Özel sayaç..."
                    Click="TimerCustomMenuItem_Click" />
          <MenuItem Header="Sayacı durdur"
                    Click="TimerStopMenuItem_Click" />
          <Separator />
          <MenuItem Header="Çıkış"
                    Click="ExitMenuItem_Click" />
        </ContextMenu>
      </Border.ContextMenu>
      <Grid>
        <Border x:Name="IslandStroke"
                CornerRadius="{Binding CornerRadius, ElementName=Island}"
                BorderBrush="#12FFFFFF"
                BorderThickness="1"
                IsHitTestVisible="False" />
        <Grid>
          <Grid x:Name="MediaCompactView" Margin="10,0">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel x:Name="CompactMediaIndicator"
                          Grid.Column="0"
                          Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border x:Name="CompactBarOne" Width="2.5" Height="6" CornerRadius="1.25" Background="#BFFFFFFF" Margin="0,0,3,0" VerticalAlignment="Center" />
                  <Border x:Name="CompactBarTwo" Width="2.5" Height="10" CornerRadius="1.25" Background="#FFFFFFFF" Margin="0,0,3,0" VerticalAlignment="Center" />
                  <Border x:Name="CompactBarThree" Width="2.5" Height="18" CornerRadius="1.25" Background="#FF1DB954" Margin="0,0,3,0" VerticalAlignment="Center" />
                  <Border x:Name="CompactBarFour" Width="2.5" Height="8" CornerRadius="1.25" Background="#FFFFFFFF" Margin="0,0,3,0" VerticalAlignment="Center" />
                  <Border x:Name="CompactBarFive" Width="2.5" Height="14" CornerRadius="1.25" Background="#BFFFFFFF" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
              <TextBlock x:Name="CompactTimerText"
                         Grid.Column="1"
                         Text="05:00"
                         Foreground="White"
                         FontSize="12.5"
                         FontWeight="SemiBold"
                         Margin="0"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Visibility="Collapsed" />
              <Border x:Name="CompactSplitDivider"
                      Grid.Column="2"
                      Width="1"
                      Height="14"
                      Background="#24FFFFFF"
                      Margin="9,0,0,0"
                      VerticalAlignment="Center"
                      Visibility="Collapsed" />
              <StackPanel x:Name="PrivacyIndicator"
                          Grid.Column="3"
                          Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0"
                          Visibility="Collapsed">
                <Ellipse x:Name="CameraDot"
                         Width="6"
                         Height="6"
                         Fill="#27D65A"
                         Margin="0,0,4,0"
                         Visibility="Collapsed" />
                <Ellipse x:Name="MicrophoneDot"
                         Width="6"
                         Height="6"
                         Fill="#FFD23F"
                         Visibility="Collapsed" />
              </StackPanel>
            </Grid>
          </Grid>

          <Grid x:Name="MediaExpandedView" Margin="16,12" Opacity="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="82" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="86" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="146" />
            </Grid.ColumnDefinitions>
            <Border Width="76"
                    Height="76"
                    CornerRadius="16"
                    Background="#1D1D1F"
                    ClipToBounds="True"
                    VerticalAlignment="Center">
              <Image x:Name="AlbumArtImage" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,14,0" VerticalAlignment="Center">
              <TextBlock x:Name="ExpandedTitleText"
                         Text="Media"
                         Foreground="White"
                         FontSize="15"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ExpandedArtistText"
                         Text="Listening"
                         Foreground="#B8FFFFFF"
                         FontSize="12.5"
                         TextTrimming="CharacterEllipsis" />
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Border Width="18"
                        Height="18"
                        CornerRadius="6"
                        Background="#20FFFFFF"
                        VerticalAlignment="Center">
                  <Path Fill="#D8FFFFFF"
                        Width="10"
                        Height="10"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 6 1.2 C 3.4 1.2 1.2 3.4 1.2 6 C 1.2 8.6 3.4 10.8 6 10.8 C 8.6 10.8 10.8 8.6 10.8 6 C 10.8 3.4 8.6 1.2 6 1.2 Z M 5 3.6 L 8 6 L 5 8.4 Z" />
                </Border>
                <TextBlock x:Name="SourceAppText"
                           Text="Media"
                           Foreground="#88FFFFFF"
                           FontSize="11"
                           Margin="7,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
              <Button x:Name="PrevButton" Click="PrevButton_Click" Style="{StaticResource MediaIconButtonStyle}">
                <Path Fill="White" Stretch="Uniform" Width="15" Height="15" Data="M 10 2 L 4 6 L 10 10 Z M 3 2 L 1.8 2 L 1.8 10 L 3 10 Z" />
              </Button>
              <Button x:Name="PlayPauseButton" Click="PlayPauseButton_Click" Style="{StaticResource MediaIconButtonStyle}">
                <Grid Width="16" Height="16">
                  <Path x:Name="PlayPauseIconPath"
                        Fill="White"
                        Stretch="Uniform"
                        Data="M 2 1 L 2 12 L 5 12 L 5 1 Z M 8 1 L 8 12 L 11 12 L 11 1 Z" />
                </Grid>
              </Button>
              <Button x:Name="NextButton" Click="NextButton_Click" Style="{StaticResource MediaIconButtonStyle}">
                <Path Fill="White" Stretch="Uniform" Width="15" Height="15" Data="M 2 2 L 8 6 L 2 10 Z M 9 2 L 10.2 2 L 10.2 10 L 9 10 Z" />
              </Button>
            </StackPanel>
            <Grid x:Name="TimerPanel"
                  Grid.Row="1"
                  Grid.ColumnSpan="3"
                  Height="24"
                  Margin="2,6,2,0"
                  Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Timer"
                         Foreground="#B8FFFFFF"
                         FontSize="10.5"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left" />
              <Border x:Name="TimerProgressTrack"
                      Grid.Column="1"
                      Height="4"
                      CornerRadius="2"
                      Background="#24FFFFFF"
                      VerticalAlignment="Center">
                <Border x:Name="TimerProgressFill"
                        Width="0"
                        HorizontalAlignment="Left"
                        CornerRadius="2"
                        Background="#FFD23F" />
              </Border>
              <TextBlock x:Name="TimerTimeText"
                         Grid.Column="2"
                         Text="25:00"
                         Foreground="White"
                         FontSize="11"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Right" />
            </Grid>
          </Grid>

          <Grid x:Name="NotificationView" Margin="14,8" Opacity="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="38"
                    Height="38"
                    CornerRadius="19"
                    Background="#24FFFFFF"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="1"
                    VerticalAlignment="Center">
              <Grid>
                <Image x:Name="NotificationLogoImage"
                       Width="30"
                       Height="30"
                       Stretch="UniformToFill"
                       Visibility="Collapsed" />
                <Path x:Name="NotificationFallbackIcon"
                      Fill="White"
                      Width="18"
                      Height="18"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 6 1.2 C 3.8 1.2 2.4 2.8 2.4 5 L 2.4 7.3 L 1.4 8.9 L 1.4 10 L 10.6 10 L 10.6 8.9 L 9.6 7.3 L 9.6 5 C 9.6 2.8 8.2 1.2 6 1.2 Z M 4.4 10.8 C 4.7 11.8 5.3 12.3 6 12.3 C 6.7 12.3 7.3 11.8 7.6 10.8 Z" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="NotificationAppText"
                         Text="Notification"
                         Foreground="White"
                         FontSize="12"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="NotificationMessageText"
                         Text=""
                         Foreground="#B8FFFFFF"
                         FontSize="10.5"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>

          <Grid x:Name="UtilityView" Margin="14,8" Opacity="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="34"
                    Height="34"
                    CornerRadius="17"
                    Background="#22FFFFFF"
                    VerticalAlignment="Center">
              <TextBlock x:Name="UtilityIconText"
                         Text="•"
                         Foreground="White"
                         FontSize="16"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="UtilityTitleText"
                         Text="WinDynamicIsland"
                         Foreground="White"
                         FontSize="12"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="UtilityDetailText"
                         Text=""
                         Foreground="#B8FFFFFF"
                         FontSize="10.5"
                         TextTrimming="CharacterEllipsis" />
              <Border Height="3"
                      CornerRadius="1.5"
                      Background="#24FFFFFF"
                      Margin="0,5,0,0">
                <Border x:Name="UtilityProgressFill"
                        Width="0"
                        HorizontalAlignment="Left"
                        CornerRadius="1.5"
                        Background="#FFFFFFFF" />
              </Border>
            </StackPanel>
          </Grid>

          <Grid x:Name="ScreenshotPreviewView" Margin="12,10" Opacity="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="24" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
              <TextBlock Text="Screenshot"
                         Foreground="White"
                         FontSize="12"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <TextBlock Text="panoya kopyalandi"
                         Foreground="#8FFFFFFF"
                         FontSize="9.5"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="1"
                    Margin="0,6,0,0"
                    CornerRadius="16"
                    Background="#141414"
                    ClipToBounds="True">
              <Image x:Name="ScreenshotPreviewImage"
                     Stretch="Uniform" />
            </Border>
          </Grid>
        </Grid>
      </Grid>
      </Border>
    </Grid>

  </Grid>
</Window>
