<Window x:Class="WinDynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDynamicIsland"
        Width="360"
        Height="120"
        Topmost="True"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
  <Window.Resources>
    <QuadraticEase x:Key="IslandEase" EasingMode="EaseInOut" />
    <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation Storyboard.TargetName="GlowBorder"
                       Storyboard.TargetProperty="Opacity"
                       From="0.45"
                       To="1"
                       Duration="0:0:0.65" />
      <DoubleAnimation Storyboard.TargetName="GlowScale"
                       Storyboard.TargetProperty="ScaleX"
                       From="1"
                       To="1.035"
                       Duration="0:0:0.65" />
      <DoubleAnimation Storyboard.TargetName="GlowScale"
                       Storyboard.TargetProperty="ScaleY"
                       From="1"
                       To="1.12"
                       Duration="0:0:0.65" />
    </Storyboard>
  </Window.Resources>

  <Grid Background="Transparent">
    <Border x:Name="Island"
            Width="190"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,8,0,0"
            CornerRadius="18"
            Background="#F0000000"
            Cursor="Hand"
            ClipToBounds="True"
            MouseLeftButtonUp="Island_MouseLeftButtonUp">
      <Grid>
        <Border x:Name="GlowBorder"
                CornerRadius="22"
                BorderThickness="1.5"
                BorderBrush="#56F45B69"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform>
            <ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1" />
          </Border.RenderTransform>
        </Border>

        <Grid Margin="12,6">
          <Grid x:Name="MediaCompactView">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="8" Height="8" Fill="#1DB954" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="TrackTitleText"
                         Text="Media"
                         Foreground="White"
                         FontSize="12"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="TrackArtistText"
                         Text="Listening"
                         Foreground="#B8FFFFFF"
                         FontSize="10"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>

          <Grid x:Name="MediaExpandedView" Opacity="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="54" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>
            <Border Width="46" Height="46" CornerRadius="6" Background="#1D1D1F" ClipToBounds="True">
              <Image x:Name="AlbumArtImage" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
              <TextBlock x:Name="ExpandedTitleText"
                         Text="Media"
                         Foreground="White"
                         FontSize="13"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ExpandedArtistText"
                         Text="Listening"
                         Foreground="#B8FFFFFF"
                         FontSize="11"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
              <Button x:Name="PrevButton" Content="&lt;&lt;" Click="PrevButton_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White" />
              <Button x:Name="PlayPauseButton" Content="||" Click="PlayPauseButton_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White" />
              <Button x:Name="NextButton" Content="&gt;&gt;" Click="NextButton_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White" />
            </StackPanel>
          </Grid>

          <Grid x:Name="RecordingView" Opacity="0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Ellipse Width="10" Height="10" Fill="#F45B69" Margin="0,0,8,0" />
              <TextBlock Text="Recording..."
                         Foreground="White"
                         FontSize="13"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Grid>

          <Grid x:Name="ThinkingView" Opacity="0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <ProgressBar Width="54"
                           Height="6"
                           Margin="0,0,10,0"
                           IsIndeterminate="True"
                           Foreground="#1DB954" />
              <TextBlock Text="Thinking..."
                         Foreground="White"
                         FontSize="13"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Grid>

          <Grid x:Name="ResponseView" Opacity="0" Visibility="Collapsed">
            <TextBlock x:Name="ResponseText"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
